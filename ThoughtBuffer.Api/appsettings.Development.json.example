{
  "LocalStorage": {
    "RootPath": "%LOCALAPPDATA%\\ThoughtBuffer\\Api",
    "MaxUploadBytes": 26214400
  },
  "ArtifactStorage": {
    "Provider": "Local",
    "LocalRootPath": "%LOCALAPPDATA%\\ThoughtBuffer\\Api\\Artifacts"
  },
  "Twilio": {
    "ValidateSignatures": false,
    "PublicBaseUrl": "",
    "ForwardToPhoneNumber": "+15555550100",
    "DefaultProcessingMode": "TranscribeAndSummarize",
    "DefaultSummarizationProfile": "IntakeCall",
    "EnableLiveMediaStreams": false,
    "LiveStreamTrack": "both_tracks",
    "LiveStreamName": "thoughtbuffer-live",
    "LiveStreamStoreMetadata": true,
    "LiveStreamStoreRawChunks": false
  }
}
